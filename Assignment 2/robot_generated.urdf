<?xml version="1.0" ?>

<robot name="eva_domestic_assistant">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.325"/>
      <geometry>
        <cylinder length="0.65" radius="0.2"/>
      </geometry>
      <material name="base_blue">
        <color rgba="0.12 0.30 0.70 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.325"/>
      <geometry>
        <cylinder length="0.65" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.325"/>
      <mass value="12"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.2"/>
    </inertial>
  </link>
  <!-- shoulder is 0.08 m above the pedestal, at the robot's x=0 axis -->
  <link name="shoulder_link">
    <visual>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
      <material name="joint_dark">
        <color rgba="0.2 0.2 0.25 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>
  <joint name="shoulder_mount" type="fixed">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.73"/>
  </joint>
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.24 0 0"/>
      <geometry>
        <box size="0.48 0.065 0.065"/>
      </geometry>
      <material name="arm_orange">
        <color rgba="0.95 0.51 0.12 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.24 0 0"/>
      <geometry>
        <box size="0.48 0.065 0.065"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.24 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.025"/>
    </inertial>
  </link>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" lower="-2.2" upper="2.2" velocity="1.2"/>
  </joint>
  <link name="forearm_link">
    <visual>
      <origin xyz="0.19 0 0"/>
      <geometry>
        <box size="0.38 0.055 0.055"/>
      </geometry>
      <material name="arm_silver">
        <color rgba="0.65 0.72 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.19 0 0"/>
      <geometry>
        <box size="0.38 0.055 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.19 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.012"/>
    </inertial>
  </link>
  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.48 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="35" lower="-2.6" upper="2.6" velocity="1.2"/>
  </joint>
  <link name="wrist_link">
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <material name="joint_dark"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.38 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="15" lower="-2.7" upper="2.7" velocity="1.2"/>
  </joint>
  <!-- finger-tip separation varies from 0.03 to gripper_span. -->
  <link name="gripper_palm">
    <visual>
      <origin xyz="0.035 0 0"/>
      <geometry>
        <box size="0.07 0.08 0.04"/>
      </geometry>
      <material name="grip_gray">
        <color rgba="0.35 0.36 0.4 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.035 0 0"/>
      <geometry>
        <box size="0.07 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.035 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="palm_mount" type="fixed">
    <parent link="wrist_link"/>
    <child link="gripper_palm"/>
    <origin xyz="0 0 0"/>
  </joint>
  <link name="left_finger">
    <visual>
      <origin xyz="0.035 0 0"/>
      <geometry>
        <box size="0.07 0.012 0.025"/>
      </geometry>
      <material name="finger_green">
        <color rgba="0.12 0.75 0.55 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.035 0 0"/>
      <geometry>
        <box size="0.07 0.012 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.035 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="left_finger_slide" type="prismatic">
    <parent link="gripper_palm"/>
    <child link="left_finger"/>
    <origin xyz="0.07 0.021 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="0" upper="0.05500000000000001" velocity="0.1"/>
  </joint>
  <link name="right_finger">
    <visual>
      <origin xyz="0.035 0 0"/>
      <geometry>
        <box size="0.07 0.012 0.025"/>
      </geometry>
      <material name="finger_green"/>
    </visual>
    <collision>
      <origin xyz="0.035 0 0"/>
      <geometry>
        <box size="0.07 0.012 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.035 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="right_finger_slide" type="prismatic">
    <parent link="gripper_palm"/>
    <child link="right_finger"/>
    <origin xyz="0.07 -0.021 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="10" lower="0" upper="0.05500000000000001" velocity="0.1"/>
  </joint>
  <!-- Frame at finger grip center, 0.105 m ahead of wrist -->
  <link name="tool0"/>
  <joint name="tool_mount" type="fixed">
    <parent link="gripper_palm"/>
    <child link="tool0"/>
    <origin xyz="0.105 0 0"/>
  </joint>
</robot>
