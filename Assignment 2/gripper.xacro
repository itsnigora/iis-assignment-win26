<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 <xacro:macro name="make_gripper" params="gripper_span">
  <!-- finger-tip separation varies from 0.03 to gripper_span. -->
  <link name="gripper_palm"><visual><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.08 0.04"/></geometry><material name="grip_gray"><color rgba="0.35 0.36 0.4 1"/></material></visual><collision><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.08 0.04"/></geometry></collision><inertial><origin xyz="0.035 0 0"/><mass value="0.25"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="palm_mount" type="fixed"><parent link="wrist_link"/><child link="gripper_palm"/><origin xyz="0 0 0"/></joint>
  <link name="left_finger"><visual><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.012 0.025"/></geometry><material name="finger_green"><color rgba="0.12 0.75 0.55 1"/></material></visual><collision><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.012 0.025"/></geometry></collision><inertial><origin xyz="0.035 0 0"/><mass value="0.08"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial></link>
  <joint name="left_finger_slide" type="prismatic"><parent link="gripper_palm"/><child link="left_finger"/><origin xyz="0.07 0.021 0"/><axis xyz="0 1 0"/><limit lower="0" upper="${(gripper_span - 0.03)/2}" effort="10" velocity="0.1"/></joint>
  <link name="right_finger"><visual><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.012 0.025"/></geometry><material name="finger_green"/></visual><collision><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.012 0.025"/></geometry></collision><inertial><origin xyz="0.035 0 0"/><mass value="0.08"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial></link>
  <joint name="right_finger_slide" type="prismatic"><parent link="gripper_palm"/><child link="right_finger"/><origin xyz="0.07 -0.021 0"/><axis xyz="0 -1 0"/><limit lower="0" upper="${(gripper_span - 0.03)/2}" effort="10" velocity="0.1"/></joint>
  <!-- Frame at finger grip center, 0.105 m ahead of wrist -->
  <link name="tool0"/>
  <joint name="tool_mount" type="fixed"><parent link="gripper_palm"/><child link="tool0"/><origin xyz="0.105 0 0"/></joint>
 </xacro:macro>
</robot>
