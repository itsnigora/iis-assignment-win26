<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="make_base" params="base_radius base_height">
    <link name="base_link">
      <visual><origin xyz="0 0 ${base_height/2}"/><geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry><material name="base_blue"><color rgba="0.12 0.30 0.70 1"/></material></visual>
      <collision><origin xyz="0 0 ${base_height/2}"/><geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry></collision>
      <inertial><origin xyz="0 0 ${base_height/2}"/><mass value="12"/><inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.2"/></inertial>
    </link>
  </xacro:macro>
</robot>
